{
  "name": "electron-react-bill",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --no-sandbox\"",
    "electron:build": "tsc -b && vite build && electron-builder",
    "release:linux": "tsc -b && vite build && electron-builder --linux AppImage deb rpm",
    "release:win": "tsc -b && vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "apexcharts": "^4.7.0",
    "flatpickr": "^4.6.13",
    "react": "^19.2.7",
    "react-apexcharts": "^1.9.0",
    "react-dom": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.1.0",
    "react-simple-maps": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-svgr": "^5.2.0",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "react-helmet-async": {
      "react": "^16.8.0 || ^17 || ^18 || ^19"
    },
    "react-simple-maps": {
      "react": "^16.8.0 || ^17 || ^18 || ^19",
      "react-dom": "^16.8.0 || ^17 || ^18 || ^19"
    }
  },
  "build": {
    "appId": "com.electronreactbill.app",
    "productName": "Electron React Bill",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": ["AppImage", "deb", "rpm"]
    },
    "win": {
      "target": ["nsis"]
    }
  }
}
